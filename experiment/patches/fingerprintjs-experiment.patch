+  winding: boolean
+  /** First raw `toDataURL()` of the text image. Never relabelled. */
+  textImage1: string
+  /** Second raw `toDataURL()` of the same, unmodified text image. Never relabelled. */
+  textImage2: string
+  /** Raw `toDataURL()` of the geometry image. Never relabelled. */
+  geometryImage: string
